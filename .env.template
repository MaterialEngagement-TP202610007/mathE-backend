DATABASE_URL="postgresql://postgres:postgres@localhost:5432/database_name"

PORT=3000
JWT_SEED="CHANGE_ME_dev_secret_only"

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
# Auth session lifetime (JWT expiry and cookie maxAge)
SESSION_TTL_HOURS=24

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_CHAT_MODEL="gemini-3.6-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS=768

# Outbound request timeouts (ms)
LAMBDA_TIMEOUT_MS=7000
GEMINI_FEEDBACK_TIMEOUT_MS=8000
GEMINI_CHAT_TIMEOUT_MS=30000
GEMINI_EMBEDDING_TIMEOUT_MS=15000
GEMINI_IMAGE_TIMEOUT_MS=60000

# Optional — question images are skipped when S3/CloudFront are not configured
AWS_BUCKET="YOUR_AWS_BUCKET"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
CLOUDFRONT_DOMAIN="https://d3f9588bxxxxxx.cloudfront.net"

QUESTION_MAX_GENERATION_ATTEMPTS=3
QUESTION_GENERATION_CONCURRENCY=2

LAMBDA_URL="https://YOUR_LAMBDA_URL/predict"

# Docker start.sh: run prisma seed on boot only when "true"
RUN_SEED=false

# Admin bootstrap (seed + `pnpm db:bootstrap-admin`). Skipped by the seed when any is unset.
# Password: at least 8 chars, letters and digits only, one letter and one digit.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
# "true" overwrites the password of an existing user with ADMIN_EMAIL
ADMIN_RESET_PASSWORD=false
